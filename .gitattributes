# Auto-detect text files and normalize to LF in the repository
* text=auto eol=lf

# Source files: always LF in repo
*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.hpp  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows build scripts: keep CRLF in working tree
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: no normalization, no diff
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.wav   binary
*.mp3   binary
*.exe   binary
*.dll   binary
*.lib   binary
*.a     binary
*.pdb   binary
*.obj   binary
*.o     binary
*.ilk   binary